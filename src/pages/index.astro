      .trust-section {
        max-width: 1450px;
        margin: 80px auto;
        padding: 20px;
      }

      .trust-title {
        text-align: center;
        font-size: 52px;
        font-weight: 900;
        margin-bottom: 16px;
      }

      .trust-subtitle {
        text-align: center;
        color: #666;
        font-size: 20px;
        margin-bottom: 50px;
      }

      .trust-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 25px;
      }

      .trust-card {
        background: white;
        padding: 35px;
        border-radius: 28px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
      }

      .trust-card h3 {
        font-size: 24px;
        margin-bottom: 18px;
      }

      .trust-card p {
        color: #666;
        line-height: 1.7;
        font-size: 17px;
      }

      .policy-section {
        max-width: 1200px;
        margin: 80px auto;
        padding: 20px;
      }

      .policy-title {
        text-align: center;
        font-size: 52px;
        font-weight: 900;
        margin-bottom: 40px;
      }

      .policy-box {
        background: white;
        padding: 40px;
        border-radius: 28px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        color: #555;
        line-height: 1.9;
        font-size: 18px;
      }

      .contact-section {
        max-width: 1000px;
        margin: 80px auto;
        padding: 20px;
        text-align: center;
      }

      .contact-container {
        background: white;
        padding: 50px;
        border-radius: 28px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
      }

      .contact-title {
        font-size: 48px;
        font-weight: 900;
        margin-bottom: 20px;
      }

      .contact-text {
        color: #666;
        font-size: 20px;
        margin-bottom: 16px;
      }

      .contact-email {
        font-size: 24px;
        font-weight: bold;
        color: #c1965c;
      }
