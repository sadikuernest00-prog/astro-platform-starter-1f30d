---
const services = [
  {
    title: "Kapitalforvaltning",
    description:
      "Skreddersydde investeringsstrategier for privatpersoner, familier og selskaper."
  },
  {
    title: "Formuesrådgivning",
    description:
      "Langsiktig planlegging av formue, arv, eiendom og generasjonsoverføring."
  },
  {
    title: "Bedriftsrådgivning",
    description:
      "Strategisk rådgivning for vekstbedrifter og investeringsselskaper."
  },
  {
    title: "Alternative Investeringer",
    description:
      "Tilgang til utvalgte muligheter innen private markeder og realaktiva."
  }
];
---

<html lang="no">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>Montis Capital | Forvaltning for Generasjoner</title>

<meta
  name="description"
  content="Montis Capital tilbyr profesjonell kapitalforvaltning, investeringsrådgivning og strategisk rådgivning for privatpersoner og bedrifter."
/>

<style>
:root{
--gold:#d4af37;
--dark:#081018;
--dark2:#101c2b;
--text:#f8fafc;
--muted:#b8c1cc;
}

*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
font-family:Inter,Arial,sans-serif;
background:var(--dark);
color:var(--text);
line-height:1.6;
}

header{
position:fixed;
top:0;
width:100%;
padding:20px 8%;
display:flex;
justify-content:space-between;
align-items:center;
background:rgba(8,16,24,.85);
backdrop-filter:blur(12px);
z-index:1000;
}

.logo{
font-size:28px;
font-weight:700;
letter-spacing:1px;
}

.logo span{
color:var(--gold);
}

nav a{
color:white;
text-decoration:none;
margin-left:30px;
transition:.3s;
}

nav a:hover{
color:var(--gold);
}

.hero{
min-height:100vh;
display:flex;
align-items:center;
justify-content:center;
text-align:center;
padding:0 20px;
background:
linear-gradient(rgba(0,0,0,.55),rgba(0,0,0,.55)),
url("https://images.unsplash.com/photo-1465447142348-e9952c393450?auto=format&fit=crop&w=2000&q=80");
background-size:cover;
background-position:center;
}

.hero-content{
max-width:900px;
}

.hero h1{
font-size:70px;
margin-bottom:15px;
}

.hero h1 span{
color:var(--gold);
}

.hero h2{
font-size:28px;
font-weight:300;
color:var(--gold);
margin-bottom:25px;
}

.hero p{
font-size:20px;
color:#d8dee6;
margin-bottom:40px;
}

.buttons{
display:flex;
justify-content:center;
gap:20px;
flex-wrap:wrap;
}

.btn{
padding:15px 35px;
border-radius:8px;
text-decoration:none;
font-weight:600;
transition:.3s;
}

.btn-primary{
background:var(--gold);
color:black;
}

.btn-primary:hover{
transform:translateY(-3px);
}

.btn-secondary{
border:1px solid var(--gold);
color:white;
}

.btn-secondary:hover{
background:var(--gold);
color:black;
}

.section{
padding:100px 8%;
}

.section-title{
text-align:center;
font-size:42px;
margin-bottom:60px;
}

.section-title span{
color:var(--gold);
}

.services{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:25px;
}

.card{
background:var(--dark2);
padding:35px;
border-radius:16px;
transition:.3s;
border:1px solid rgba(212,175,55,.15);
}

.card:hover{
transform:translateY(-8px);
border-color:var(--gold);
}

.card h3{
color:var(--gold);
margin-bottom:15px;
}

.philosophy{
max-width:900px;
margin:auto;
text-align:center;
font-size:22px;
color:var(--muted);
}

.stats{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:25px;
margin-top:50px;
}

.stat{
background:var(--dark2);
padding:40px;
border-radius:16px;
text-align:center;
}

.stat h3{
font-size:42px;
color:var(--gold);
margin-bottom:10px;
}

.contact{
text-align:center;
}

.contact h2{
margin-bottom:20px;
}

.contact p{
font-size:18px;
color:var(--muted);
}

footer{
padding:40px;
text-align:center;
border-top:1px solid rgba(255,255,255,.08);
color:#7c8898;
}

@media(max-width:768px){

.hero h1{
font-size:50px;
}

.hero h2{
font-size:22px;
}

nav{
display:none;
}

.section-title{
font-size:32px;
}
}
</style>
</head>

<body>

<header>
<div class="logo">Montis <span>Capital</span></div>

<nav>
<a href="#services">Tjenester</a>
<a href="#philosophy">Filosofi</a>
<a href="#contact">Kontakt</a>
</nav>
</header>

<section class="hero">

<div class="hero-content">

<h1>Montis <span>Capital</span></h1>

<h2>Forvaltning for Generasjoner</h2>

<p>
Vi hjelper investorer, familier og bedrifter med å bygge,
bevare og utvikle verdier gjennom disiplinert kapitalforvaltning,
strategisk rådgivning og langsiktig tenkning.
</p>

<div class="buttons">
<a
href="https://wa.me/4792928373?text=Hei%20Montis%20Capital!%0A%0AJeg%20%C3%B8nsker%20%C3%A5%20booke%20et%20m%C3%B8te.%0A%0A------------------------%0A%0ANavn:%20%0ATelefon:%20%0AE-post:%20%0A%0AØnsket%20dato:%20%0AØnsket%20tid:%20%0A%0AKort%20beskrivelse:%20"
class="btn btn-primary"
target="_blank"
rel="noopener noreferrer"
>
Book et møte
</a>

<a href="#services" class="btn btn-secondary">
Våre tjenester
</a>
</div>
</div>
</section>

<section class="section" id="services">

<h2 class="section-title">
Våre <span>Tjenester</span>
</h2>

<div class="services">
{
services.map(service => (
<div class="card">
<h3>{service.title}</h3>
<p>{service.description}</p>
</div>
))
}
</div>

</section>

<section class="section" id="philosophy">

<h2 class="section-title">
Vår <span>Investeringsfilosofi</span>
</h2>

<div class="philosophy">
<p>
Kapital skal ikke bare vokse.
Den skal forvaltes med disiplin, ansvar og langsiktig perspektiv.
Montis Capital fokuserer på bærekraftig verdiskaping fremfor
kortsiktig spekulasjon.
</p>
</div>

<div class="stats">

<div class="stat">
<h3>100%</h3>
<p>Uavhengig rådgivning</p>
</div>

<div class="stat">
<h3>Langsiktig</h3>
<p>Investeringsstrategi</p>
</div>

<div class="stat">
<h3>Tillit</h3>
<p>Diskresjon og integritet</p>
</div>

<div class="stat">
<h3>Fokus</h3>
<p>Verdiskaping over tid</p>
</div>

</div>

</section>

<section class="section contact" id="contact">

<h2 class="section-title">
Kontakt <span>Montis Capital</span>
</h2>

<p>
Oslo, Norge
</p>

<p>
kontakt@montiscapital.no
</p>

<p>
+47 000 00 000
</p>

</section>

<footer>
© 2026 Montis Capital. Alle rettigheter forbeholdt.
</footer>

</body>
</html>
