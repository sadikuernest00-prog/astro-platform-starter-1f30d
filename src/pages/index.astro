
---
const products = [
  {
    id: 1,
    name: "Élise Satin Set",
    price: 599,
    image: "/images/nude-bra.jpg",
    badge: "BEST SELLER",
    description: "Ultra-soft premium satin comfort with elegant support.",
    stripe: "https://buy.stripe.com/test_6oU5kC57V9y759y6jP7Re04",
  },

  {
    id: 2,
    name: "Noir Essence Collection",
    price: 599,
    image: "/images/black-bra.jpg",
    badge: "NEW",
    description: "Luxury black collection designed for confidence.",
    stripe: "https://buy.stripe.com/test_bJecN4gQD4dN31qfUp7Re03",
  },

  {
    id: 3,
    name: "Veloura Active",
    price: 499,
    image: "/images/black-set.jpg",
    badge: "HOT",
    description: "Modern activewear comfort for everyday elegance.",
    stripe: "https://buy.stripe.com/test_4gM5kCeIvdOnfOccId7Re02",
  },

  {
    id: 4,
    name: "Aura Luxe",
    price: 599,
    image: "/images/black-b.jpg",
    badge: "LIMITED",
    description: "Elegant premium luxury crafted for softness.",
    stripe: "https://buy.stripe.com/test_4gM3cu2ZNcKjdG423z7Re01",
  },
];
---

<html lang="en">
  <head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Amic Underwear — Luxury Comfort & Elegance</title>

    <meta
      name="description"
      content="Premium luxury underwear designed for comfort, confidence and elegance."
    />

    <style>

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: Arial, sans-serif;
        background: #f7f7f7;
        color: #111;
        overflow-x: hidden;
      }

      a {
        text-decoration: none;
      }

      .top-banner {
        background: linear-gradient(to right, #000, #222);
        color: white;
        text-align: center;
        padding: 14px;
        font-size: 14px;
        font-weight: bold;
        letter-spacing: 1px;
      }

      .navbar {
        position: sticky;
        top: 0;
        z-index: 999;
        width: 100%;
        background: rgba(255,255,255,0.95);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid #eee;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 40px;
      }

      .logo {
        font-size: 42px;
        font-weight: 900;
        letter-spacing: -1px;
      }

      .logo span {
        color: #c1965c;
      }

      .nav-links {
        display: flex;
        gap: 28px;
        align-items: center;
      }

      .nav-links a {
        color: #111;
        font-weight: bold;
        font-size: 15px;
      }

      .cart-btn {
        background: black;
        color: white;
        border: none;
        border-radius: 999px;
        padding: 14px 24px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.25s;
      }

      .hero {
        min-height: 92vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 100px 20px;
        background:
          linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)),
          url('/images/hero.jpg');
        background-size: cover;
        background-position: center;
        color: white;
      }

      .hero-content {
        max-width: 900px;
      }

      .hero-tag {
        display: inline-block;
        padding: 10px 20px;
        border-radius: 999px;
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        margin-bottom: 25px;
        font-size: 14px;
        font-weight: bold;
      }

      .hero h1 {
        font-size: 82px;
        line-height: 1;
        margin-bottom: 26px;
        font-weight: 900;
      }

      .hero p {
        font-size: 24px;
        line-height: 1.7;
        color: rgba(255,255,255,0.9);
        max-width: 700px;
        margin: auto;
      }

      .hero-buttons {
        margin-top: 40px;
        display: flex;
        justify-content: center;
        gap: 18px;
        flex-wrap: wrap;
      }

      .hero-btn {
        padding: 18px 36px;
        border-radius: 999px;
        font-size: 18px;
        font-weight: bold;
        transition: 0.25s;
      }

      .primary-btn {
        background: #c1965c;
        color: white;
      }

      .secondary-btn {
        border: 2px solid white;
        color: white;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        max-width: 1400px;
        margin: -70px auto 0;
        padding: 0 20px;
        position: relative;
        z-index: 2;
      }

      .stat-card {
        background: white;
        border-radius: 28px;
        padding: 40px;
        text-align: center;
        box-shadow: 0 20px 50px rgba(0,0,0,0.08);
      }

      .stat-card h3 {
        font-size: 42px;
        margin-bottom: 12px;
      }

      .section-title {
        text-align: center;
        font-size: 58px;
        font-weight: 900;
        margin-bottom: 18px;
      }

      .section-subtitle {
        text-align: center;
        max-width: 760px;
        margin: auto auto 60px;
        color: #666;
        font-size: 20px;
        line-height: 1.8;
      }

      .products-section {
        padding: 120px 20px 60px;
      }

      .products {
        max-width: 1450px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 28px;
      }

      .card {
        background: white;
        border-radius: 32px;
        overflow: hidden;
        box-shadow: 0 18px 45px rgba(0,0,0,0.06);
        transition: 0.35s;
      }

      .card:hover {
        transform: translateY(-10px);
      }

      .image-wrapper {
        position: relative;
        overflow: hidden;
      }

      .card img {
        width: 100%;
        height: 460px;
        object-fit: cover;
        transition: 0.4s;
      }

      .card:hover img {
        transform: scale(1.05);
      }

      .badge {
        position: absolute;
        top: 20px;
        left: 20px;
        background: #c1965c;
        color: white;
        padding: 10px 18px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: bold;
      }

      .content {
        padding: 30px;
      }

      .content h2 {
        font-size: 34px;
        margin-bottom: 14px;
      }

      .product-description {
        color: #666;
        line-height: 1.7;
        margin-bottom: 20px;
      }

      .price {
        font-size: 42px;
        color: #c1965c;
        font-weight: 900;
        margin-bottom: 20px;
      }

      .sizes,
      .quantity {
        width: 100%;
        border: 1px solid #ddd;
        border-radius: 14px;
        padding: 15px;
        margin-bottom: 14px;
        font-size: 16px;
      }

      .buttons {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .btn {
        width: 100%;
        border: none;
        border-radius: 999px;
        padding: 18px;
        font-size: 17px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.25s;
        text-align: center;
      }

      .cart-add {
        background: #c1965c;
        color: white;
      }

      .stripe {
        background: black;
        color: white;
      }

      .trust-bar {
        margin-top: 14px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
      }

      .trust-pill {
        padding: 10px 14px;
        border-radius: 999px;
        background: #f1f1f1;
        font-size: 13px;
        font-weight: bold;
      }

      .reviews-section,
      .trustpilot-section {
        padding: 100px 20px;
      }

      .reviews-grid,
      .trustpilot-grid {
        max-width: 1450px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 25px;
      }

      .review-card,
      .trustpilot-card {
        background: white;
        border-radius: 28px;
        padding: 35px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
      }

      .stars,
      .tp-stars {
        color: #00b67a;
        font-size: 24px;
        margin-bottom: 18px;
      }

      .review-text,
      .trustpilot-card p {
        color: #555;
        line-height: 1.8;
        font-size: 18px;
      }

      .review-name {
        margin-top: 18px;
        font-weight: bold;
      }

      .trustpilot-header {
        text-align: center;
        margin-bottom: 60px;
      }

      .trustpilot-stars {
        color: #00b67a;
        font-size: 42px;
        margin-bottom: 20px;
      }

      .trustpilot-header h2 {
        font-size: 58px;
        margin-bottom: 18px;
      }

      .newsletter {
        padding: 120px 20px;
        background: black;
        color: white;
        text-align: center;
      }

      .newsletter h2 {
        font-size: 58px;
        margin-bottom: 20px;
      }

      .newsletter-form {
        max-width: 700px;
        margin: auto;
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        justify-content: center;
      }

      .newsletter-form input {
        flex: 1;
        min-width: 260px;
        padding: 18px;
        border-radius: 999px;
        border: none;
        font-size: 16px;
      }

      .newsletter-form button {
        padding: 18px 32px;
        border-radius: 999px;
        border: none;
        background: #c1965c;
        color: white;
        font-weight: bold;
        cursor: pointer;
      }

      .cart-sidebar {
        position: fixed;
        top: 0;
        right: -450px;
        width: 420px;
        height: 100%;
        background: white;
        padding: 30px;
        transition: 0.35s;
        z-index: 2000;
        overflow-y: auto;
        box-shadow: -10px 0 40px rgba(0,0,0,0.15);
      }

      .cart-sidebar.active {
        right: 0;
      }

      .close-cart {
        position: absolute;
        top: 20px;
        right: 20px;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: none;
        background: black;
        color: white;
        cursor: pointer;
      }

      .cart-title {
        font-size: 34px;
        margin-bottom: 30px;
      }

      .cart-item {
        padding: 20px 0;
        border-bottom: 1px solid #eee;
      }

      .cart-total {
        font-size: 30px;
        font-weight: 900;
        margin-top: 30px;
      }

      .checkout-btn {
        margin-top: 20px;
        width: 100%;
        padding: 18px;
        border-radius: 999px;
        border: none;
        background: black;
        color: white;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
      }

      .footer {
        background: white;
        padding: 80px 20px;
      }

      .footer-container {
        max-width: 1450px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 40px;
      }

      .footer h3 {
        margin-bottom: 20px;
        font-size: 24px;
      }

      .footer p,
      .footer a {
        color: #666;
        line-height: 2;
      }

      .footer-bottom {
        margin-top: 60px;
        text-align: center;
        color: #777;
      }

      @media (max-width: 768px) {

        .hero h1 {
          font-size: 48px;
        }

        .hero p {
          font-size: 18px;
        }

        .navbar {
          padding: 18px 20px;
        }

        .nav-links {
          display: none;
        }

        .logo {
          font-size: 28px;
        }

        .section-title,
        .trustpilot-header h2,
        .newsletter h2 {
          font-size: 42px;
        }

        .card img {
          height: 360px;
        }

        .cart-sidebar {
          width: 100%;
        }

      }

    </style>

  </head>

  <body>

    <div class="top-banner">
      FREE WORLDWIDE SHIPPING • PREMIUM QUALITY • SECURE CHECKOUT
    </div>

    <nav class="navbar">

      <div class="logo">
        Amic<span>Underwear</span>
      </div>

      <div class="nav-links">
        <a href="#products">Shop</a>
        <a href="#reviews">Reviews</a>
        <a href="#trust">Trustpilot</a>
      </div>

      <button class="cart-btn" onclick="toggleCart()">
        Cart (<span id="cart-count">0</span>)
      </button>

    </nav>

    <section class="hero">

      <div class="hero-content">

        <div class="hero-tag">
          PREMIUM LUXURY UNDERWEAR
        </div>

        <h1>
          Confidence Begins With Comfort
        </h1>

        <p>
          Luxury underwear crafted with premium softness,
          elegant design and modern comfort trusted worldwide.
        </p>

      </div>

    </section>
