---
const products = [
  {
    name: "Aura Luxe",
    price: "$89",
    image:
      "https://images.unsplash.com/photo-1529139574466-a303027c1d8b?q=80&w=1200&auto=format&fit=crop",
    description: "Luxury black lace underwear with premium comfort."
  },
  {
    name: "Noir Essence",
    price: "$74",
    image:
      "https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=1200&auto=format&fit=crop",
    description: "Minimal modern design with soft premium fabric."
  },
  {
    name: "Velvet Touch",
    price: "$95",
    image:
      "https://images.unsplash.com/photo-1483985988355-763728e1935b?q=80&w=1200&auto=format&fit=crop",
    description: "Elegant luxury underwear crafted for style."
  }
];

const currentYear = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>AmicBridge — Luxury Underwear</title>

    <meta
      name="description"
      content="Luxury modern underwear brand with premium design and secure payments."
    />

    <style>
      :root {
        --bg: #050505;
        --card: #101010;
        --text: #ffffff;
        --muted: #9d9d9d;
        --line: rgba(255,255,255,0.08);
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: Inter, Arial, sans-serif;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: 92%;
        max-width: 1400px;
        margin: auto;
      }

      header {
        position: fixed;
        width: 100%;
        top: 0;
        z-index: 1000;
        backdrop-filter: blur(16px);
        background: rgba(5,5,5,0.72);
        border-bottom: 1px solid var(--line);
      }

      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 0;
      }

      .logo {
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: 3px;
      }

      .nav-links {
        display: flex;
        gap: 28px;
      }

      .nav-links a {
        color: var(--muted);
        transition: 0.3s;
      }

      .nav-links a:hover {
        color: white;
      }

      .hero {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
        padding-top: 120px;
      }

      .hero-text h1 {
        font-size: 5rem;
        line-height: 0.95;
        margin-bottom: 26px;
      }

      .hero-text p {
        color: var(--muted);
        font-size: 1.1rem;
        line-height: 1.8;
        max-width: 540px;
        margin-bottom: 35px;
      }

      .hero-buttons {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
      }

      .btn {
        padding: 15px 28px;
        border-radius: 999px;
        font-weight: 600;
        transition: 0.3s;
      }

      .btn-primary {
        background: white;
        color: black;
      }

      .btn-primary:hover {
        transform: translateY(-2px);
      }

      .btn-secondary {
        border: 1px solid var(--line);
      }

      .hero-image img {
        width: 100%;
        height: 85vh;
        object-fit: cover;
        border-radius: 28px;
      }

      .section {
        padding: 120px 0;
      }

      .section-title {
        font-size: 2.4rem;
        margin-bottom: 50px;
      }

      .products {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 28px;
      }

      .product-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 28px;
        overflow: hidden;
        transition: 0.35s;
      }

      .product-card:hover {
        transform: translateY(-6px);
      }

      .product-card img {
        width: 100%;
        height: 430px;
        object-fit: cover;
      }

      .product-info {
        padding: 24px;
      }

      .product-info h3 {
        font-size: 1.3rem;
        margin-bottom: 12px;
      }

      .product-info p {
        color: var(--muted);
        line-height: 1.7;
        margin-bottom: 20px;
      }

      .price-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .price {
        font-weight: 700;
        font-size: 1.15rem;
      }

      .buy-btn {
        background: white;
        color: black;
        padding: 10px 18px;
        border-radius: 999px;
        font-weight: 600;
      }

      .about {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
      }

      .about img {
        width: 100%;
        height: 650px;
        object-fit: cover;
        border-radius: 28px;
      }

      .about-text p {
        color: var(--muted);
        line-height: 1.9;
        margin-bottom: 20px;
      }

      .trust-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 24px;
      }

      .trust-box {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 28px;
      }

      .trust-box h3 {
        margin-bottom: 14px;
      }

      .trust-box p {
        color: var(--muted);
        line-height: 1.7;
      }

      .privacy {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 28px;
        padding: 40px;
      }

      .privacy h3 {
        margin-top: 30px;
        margin-bottom: 12px;
      }

      .privacy p {
        color: var(--muted);
        line-height: 1.8;
      }

      footer {
        border-top: 1px solid var(--line);
        padding: 60px 0;
        margin-top: 80px;
      }

      .footer-content {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 20px;
      }

      .footer-links {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
      }

      .footer-links a {
        color: var(--muted);
      }

      .footer-links a:hover {
        color: white;
      }

      @media (max-width: 900px) {
        .hero,
        .about {
          grid-template-columns: 1fr;
        }

        .hero-text h1 {
          font-size: 3.5rem;
        }

        .hero-image img,
        .about img {
          height: 500px;
        }

        .nav-links {
          display: none;
        }

        .section {
          padding: 90px 0;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="container">
        <nav>
          <div class="logo">AMICBRIDGE</div>

          <div class="nav-links">
            <a href="#shop">Shop</a>
            <a href="#about">About</a>
            <a href="#trust">Trust</a>
            <a href="#privacy">Privacy</a>
          </div>
        </nav>
      </div>
    </header>

    <main class="container">
      <section class="hero">
        <div class="hero-text">
          <h1>
            Luxury
            <br />
            Underwear
            <br />
            Reimagined
          </h1>

          <p>
            Modern luxury underwear designed for comfort,
            confidence, and timeless minimalist aesthetics.
          </p>

          <div class="hero-buttons">
            <a href="#shop" class="btn btn-primary">
              Shop Collection
            </a>

            <a href="#privacy" class="btn btn-secondary">
              Privacy & Trust
            </a>
          </div>
        </div>

        <div class="hero-image">
          <img
            src="https://images.unsplash.com/photo-1496747611176-843222e1e57c?q=80&w=1400&auto=format&fit=crop"
            alt="Luxury Fashion"
          />
        </div>
      </section>

      <section class="section" id="shop">
        <h2 class="section-title">Featured Collection</h2>

        <div class="products">
          {
            products.map((product) => (
              <div class="product-card">
                <img src={product.image} alt={product.name} />

                <div class="product-info">
                  <h3>{product.name}</h3>

                  <p>{product.description}</p>

                  <div class="price-row">
                    <span class="price">{product.price}</span>

                    <a href="#" class="buy-btn">
                      Buy Now
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="section about" id="about">
        <img
          src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?q=80&w=1200&auto=format&fit=crop"
          alt="About AmicBridge"
        />

        <div class="about-text">
          <h2 class="section-title">
            Built For Modern Luxury
          </h2>

          <p>
            AmicBridge combines premium comfort,
            minimalist aesthetics, and modern digital commerce.
          </p>

          <p>
            Every collection is crafted with attention
            to detail, elegance, and timeless style.
          </p>

          <p>
            We believe online shopping should feel secure,
            premium, and effortless.
          </p>
        </div>
      </section>

      <section class="section" id="trust">
        <h2 class="section-title">Why Customers Trust Us</h2>

        <div class="trust-grid">
          <div class="trust-box">
            <h3>Secure Checkout</h3>

            <p>
              Protected payment processing with secure encrypted checkout systems.
            </p>
          </div>

          <div class="trust-box">
            <h3>Premium Quality</h3>

            <p>
              Carefully selected materials designed for luxury comfort and durability.
            </p>
          </div>

          <div class="trust-box">
            <h3>Private Shopping</h3>

            <p>
              Customer information is handled with privacy and confidentiality.
            </p>
          </div>

          <div class="trust-box">
            <h3>Fast Support</h3>

            <p>
              Dedicated customer assistance for questions, orders, and support.
            </p>
          </div>
        </div>
      </section>

      <section class="section" id="privacy">
        <h2 class="section-title">Privacy Policy</h2>

        <div class="privacy">
          <p>
            At AmicBridge, we value your privacy and are committed to protecting your personal information.
          </p>

          <h3>Information We Collect</h3>

          <p>
            We may collect information such as your name,
            email address, shipping address, and payment details
            when you place an order or contact us.
          </p>

          <h3>How We Use Information</h3>

          <p>
            Your information is used to process orders,
            improve customer experience, provide support,
            and maintain website security.
          </p>

          <h3>Payment Security</h3>

          <p>
            Payments are securely processed through trusted payment providers.
            Sensitive payment information is not stored directly on our servers.
          </p>

          <h3>Cookies</h3>

          <p>
            Our website may use cookies and analytics tools
            to improve performance and user experience.
          </p>

          <h3>Contact</h3>

          <p>
            For privacy-related questions, contact:
            support@amicbridge.com
          </p>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-content">
        <div>
          <div class="logo">AMICBRIDGE</div>
        </div>

        <div class="footer-links">
          <a href="#shop">Shop</a>
          <a href="#about">About</a>
          <a href="#privacy">Privacy</a>
          <a href="#">Shipping</a>
          <a href="#">Returns</a>
          <a href="#">Contact</a>
        </div>

        <p style="color: var(--muted)">
          © {currentYear} AmicBridge. All rights reserved.
        </p>
      </div>
    </footer>
  </body>
</html>
