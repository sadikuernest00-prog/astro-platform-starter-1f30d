---
const supportedCoins = [
  "Bitcoin",
  "XRP",
  "USDC",
  "Ethereum",
  "Monero",
  "Litecoin"
];
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>AmicBridge | Crypto Payment Infrastructure</title>

  <meta
    name="description"
    content="Accept cryptocurrency payments globally with AmicBridge."
  />

  <style>
    :root {
      --bg: #050816;
      --card: rgba(255,255,255,0.05);
      --border: rgba(255,255,255,0.12);
      --text: #ffffff;
      --muted: #9ca3af;
      --accent: #4f8cff;
      --accent2: #00d4ff;
    }

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    body{
      font-family: Inter, system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      overflow-x:hidden;
    }

    body::before{
      content:"";
      position:fixed;
      inset:0;
      background:
        radial-gradient(circle at top left,#4f8cff33,transparent 30%),
        radial-gradient(circle at top right,#00d4ff22,transparent 30%);
      z-index:-1;
    }

    .container{
      width:min(1200px,92%);
      margin:auto;
    }

    nav{
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:24px 0;
    }

    .logo{
      font-size:1.6rem;
      font-weight:800;
      letter-spacing:.5px;
    }

    .logo span{
      color:var(--accent);
    }

    .nav-links{
      display:flex;
      gap:24px;
    }

    .nav-links a{
      text-decoration:none;
      color:#d1d5db;
    }

    .btn{
      background:linear-gradient(135deg,var(--accent),var(--accent2));
      color:white;
      padding:14px 24px;
      border-radius:12px;
      text-decoration:none;
      font-weight:700;
    }

    .hero{
      padding:100px 0 80px;
      text-align:center;
    }

    .badge{
      display:inline-block;
      padding:10px 18px;
      border:1px solid var(--border);
      background:var(--card);
      border-radius:999px;
      color:#cbd5e1;
      margin-bottom:24px;
    }

    h1{
      font-size:clamp(3rem,8vw,6rem);
      line-height:1;
      max-width:1000px;
      margin:auto;
      font-weight:900;
    }

    .gradient{
      background:linear-gradient(90deg,#4f8cff,#00d4ff);
      -webkit-background-clip:text;
      -webkit-text-fill-color:transparent;
    }

    .hero p{
      margin:30px auto;
      max-width:750px;
      font-size:1.2rem;
      color:var(--muted);
      line-height:1.8;
    }

    .hero-buttons{
      display:flex;
      gap:16px;
      justify-content:center;
      flex-wrap:wrap;
      margin-top:20px;
    }

    .secondary{
      border:1px solid var(--border);
      background:var(--card);
    }

    .stats{
      margin-top:80px;
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:20px;
    }

    .stat{
      background:var(--card);
      border:1px solid var(--border);
      border-radius:20px;
      padding:30px;
      backdrop-filter:blur(20px);
    }

    .stat h3{
      font-size:2rem;
      margin-bottom:10px;
    }

    .section{
      padding:100px 0;
    }

    .section-title{
      text-align:center;
      font-size:3rem;
      margin-bottom:20px;
    }

    .section-sub{
      text-align:center;
      color:var(--muted);
      max-width:700px;
      margin:0 auto 60px;
    }

    .features{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:24px;
    }

    .card{
      background:var(--card);
      border:1px solid var(--border);
      border-radius:24px;
      padding:30px;
      backdrop-filter:blur(20px);
      transition:.3s;
    }

    .card:hover{
      transform:translateY(-6px);
    }

    .card h3{
      margin-bottom:12px;
      font-size:1.3rem;
    }

    .card p{
      color:var(--muted);
      line-height:1.7;
    }

    .coins{
      display:grid;
      grid-template-columns:repeat(6,1fr);
      gap:16px;
    }

    .coin{
      text-align:center;
      padding:20px;
      border-radius:18px;
      background:var(--card);
      border:1px solid var(--border);
    }

    .cta{
      text-align:center;
      padding:120px 0;
    }

    .cta h2{
      font-size:4rem;
      margin-bottom:20px;
    }

    footer{
      border-top:1px solid var(--border);
      padding:40px 0;
      text-align:center;
      color:var(--muted);
    }

    @media(max-width:900px){

      .features{
        grid-template-columns:1fr;
      }

      .stats{
        grid-template-columns:1fr 1fr;
      }

      .coins{
        grid-template-columns:repeat(2,1fr);
      }

      .nav-links{
        display:none;
      }
    }
  </style>
</head>

<body>

<div class="container">

  <nav>
    <div class="logo">
      Amic<span>Bridge</span>
    </div>

    <div class="nav-links">
      <a href="#features">Features</a>
      <a href="#coins">Currencies</a>
      <a href="#contact">Contact</a>
    </div>

    <a href="#" class="btn">Get Started</a>
  </nav>

  <section class="hero">

    <div class="badge">
      Next Generation Crypto Payment Infrastructure
    </div>

    <h1>
      Accept Crypto Payments
      <span class="gradient">Anywhere In The World</span>
    </h1>

    <p>
      AmicBridge helps businesses accept Bitcoin, XRP, USDC,
      Ethereum, Monero and more through a modern digital payment
      experience built for the future of commerce.
    </p>

    <div class="hero-buttons">
      <a href="#" class="btn">Start Accepting Crypto</a>
      <a href="#" class="btn secondary">Book Demo</a>
    </div>

    <div class="stats">
      <div class="stat">
        <h3>100+</h3>
        <p>Supported Markets</p>
      </div>

      <div class="stat">
        <h3>24/7</h3>
        <p>Global Availability</p>
      </div>

      <div class="stat">
        <h3>6+</h3>
        <p>Supported Assets</p>
      </div>

      <div class="stat">
        <h3>Enterprise</h3>
        <p>Ready Infrastructure</p>
      </div>
    </div>

  </section>

  <section id="features" class="section">

    <h2 class="section-title">
      Built For Modern Businesses
    </h2>

    <p class="section-sub">
      Everything needed to accept cryptocurrency payments through
      one professional platform.
    </p>

    <div class="features">

      <div class="card">
        <h3>Multi-Currency Support</h3>
        <p>
          Accept major digital assets through one integration.
        </p>
      </div>

      <div class="card">
        <h3>Merchant Dashboard</h3>
        <p>
          Track transactions and monitor payment activity.
        </p>
      </div>

      <div class="card">
        <h3>Global Reach</h3>
        <p>
          Receive payments from customers worldwide.
        </p>
      </div>

    </div>

  </section>

  <section id="coins" class="section">

    <h2 class="section-title">
      Supported Currencies
    </h2>

    <div class="coins">

      {supportedCoins.map((coin) => (
        <div class="coin">{coin}</div>
      ))}

    </div>

  </section>

  <section class="cta">

    <h2>
      Ready To Grow With Crypto?
    </h2>

    <p style="color:#9ca3af;margin-bottom:30px;">
      Join the next generation of digital commerce.
    </p>

    <a href="#" class="btn">
      Contact Sales
    </a>

  </section>

  <footer id="contact">
    © 2026 AmicBridge. All Rights Reserved.
  </footer>

</div>

</body>
</html>
