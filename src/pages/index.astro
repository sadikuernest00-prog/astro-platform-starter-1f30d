---
const services = [
  "Kapitalforvaltning",
  "Investeringsrådgivning",
  "Formuesforvaltning",
  "Pensjonsplanlegging",
  "Bedriftsrådgivning",
  "Eiendomsinvesteringer"
];
---

<html lang="no">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Montis Capital | Forvaltning & Rådgivning</title>

  <meta
    name="description"
    content="Montis Capital tilbyr profesjonell kapitalforvaltning, investeringsrådgivning og strategisk rådgivning for privatpersoner og bedrifter."
  />

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0f172a;
      color: white;
    }

    .hero {
      text-align: center;
      padding: 120px 20px;
      background: linear-gradient(135deg,#0f172a,#1e293b);
    }

    .hero h1 {
      font-size: 4rem;
      margin-bottom: 20px;
    }

    .hero p {
      max-width: 700px;
      margin: auto;
      color: #cbd5e1;
      font-size: 1.2rem;
    }

    .btn {
      display: inline-block;
      margin-top: 30px;
      padding: 14px 32px;
      background: #d4af37;
      color: #000;
      text-decoration: none;
      border-radius: 8px;
      font-weight: bold;
    }

    .services {
      padding: 80px 20px;
      max-width: 1200px;
      margin: auto;
    }

    .services h2 {
      text-align: center;
      margin-bottom: 40px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit,minmax(250px,1fr));
      gap: 20px;
    }

    .card {
      background: #1e293b;
      padding: 25px;
      border-radius: 12px;
    }

    footer {
      text-align: center;
      padding: 40px;
      color: #94a3b8;
    }
  </style>
</head>

<body>

<section class="hero">
  <h1>Montis Capital</h1>

  <p>
    Uavhengig kapitalforvaltning og strategisk rådgivning.
    Vi hjelper privatpersoner, investorer og bedrifter med å bygge,
    beskytte og utvikle verdier over tid.
  </p>

  <a href="#kontakt" class="btn">Kontakt oss</a>
</section>

<section class="services">
  <h2>Våre Tjenester</h2>

  <div class="grid">
    {services.map(service => (
      <div class="card">
        <h3>{service}</h3>
      </div>
    ))}
  </div>
</section>

<section class="services">
  <h2>Hvorfor Montis Capital?</h2>

  <div class="grid">
    <div class="card">
      <h3>Langsiktig strategi</h3>
      <p>Vi fokuserer på bærekraftig verdiskaping over tid.</p>
    </div>

    <div class="card">
      <h3>Uavhengig rådgivning</h3>
      <p>Råd basert på kundens interesser og mål.</p>
    </div>

    <div class="card">
      <h3>Diskresjon og tillit</h3>
      <p>Profesjonell håndtering av kapital og sensitive beslutninger.</p>
    </div>
  </div>
</section>

<footer id="kontakt">
  <h3>Montis Capital</h3>
  <p>Forvaltning • Investering • Rådgivning</p>
  <p>kontakt@montiscapital.no</p>
</footer>

</body>
</html>
