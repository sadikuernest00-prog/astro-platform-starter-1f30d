---
const products = [
  {
    name: "Midnight Lace Set",
    price: "$89",
    image:
      "https://images.unsplash.com/photo-1529139574466-a303027c1d8b?q=80&w=1200&auto=format&fit=crop",
    description: "Luxury black lace underwear with premium comfort."
  },
  {
    name: "Silk Noir Collection",
    price: "$74",
    image:
      "https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=1200&auto=format&fit=crop",
    description: "Minimal modern design with soft premium fabric."
  },
  {
    name: "Velvet Signature",
    price: "$95",
    image:
      "https://images.unsplash.com/photo-1483985988355-763728e1935b?q=80&w=1200&auto=format&fit=crop",
    description: "Elegant luxury underwear crafted for style."
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>AmicBridge — Luxury Underwear</title>

    <meta
      name="description"
      content="Luxury modern underwear brand with premium design and crypto payments."
    />

    <style>
      :root {
        --bg: #050505;
        --card: #101010;
        --text: #ffffff;
        --muted: #999999;
        --line: rgba(255,255,255,0.08);
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: Inter, Arial, sans-serif;
        overflow-x: hidden;
      }

      a {
        text-decoration: none;
        color: inherit;
      }

      .container {
        width: 92%;
        max-width: 1400px;
        margin: auto;
      }

      header {
        position: fixed;
        width: 100%;
        top: 0;
        left: 0;
        z-index: 1000;
        backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--line);
        background: rgba(5,5,5,0.7);
      }

      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 0;
      }

      .logo {
        font-size: 1.4rem;
        font-weight: 700;
        letter-spacing: 3px;
      }

      .nav-links {
        display: flex;
        gap: 28px;
      }

      .nav-links a {
        color: var(--muted);
        transition: 0.3s;
      }

      .nav-links a:hover {
        color: white;
      }

      .hero {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 60px;
        padding-top: 120px;
      }

      .hero-text h1 {
        font-size: 5rem;
        line-height: 0.95;
        margin-bottom: 24px;
      }

      .hero-text p {
        color: var(--muted);
        font-size: 1.1rem;
        max-width: 550px;
        line-height: 1.7;
        margin-bottom: 35px;
      }

      .hero-buttons {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
      }

      .btn {
        padding: 15px 28px;
        border-radius: 999px;
        font-weight: 600;
        transition: 0.3s;
      }

      .btn-primary {
        background: white;
        color: black;
      }

      .btn-primary:hover {
        transform: translateY(-2px);
      }

      .btn-secondary {
        border: 1px solid var(--line);
        color: white;
      }

      .hero-image img {
        width: 100%;
        height: 85vh;
        object-fit: cover;
        border-radius: 30px;
      }

      .section {
        padding: 120px 0;
      }

      .section-title {
        font-size: 2.5rem;
        margin-bottom: 50px;
      }

      .products {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
      }

      .product-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 28px;
        overflow: hidden;
        transition: 0.4s;
      }

      .product-card:hover {
        transform: translateY(-8px);
      }

      .product-card img {
        width: 100%;
        height: 420px;
        object-fit: cover;
      }

      .product-info {
        padding: 24px;
      }

      .product-info h3 {
        font-size: 1.3rem;
        margin-bottom: 12px;
      }

      .product-info p {
        color: var(--muted);
        line-height: 1.6;
        margin-bottom: 20px;
      }

      .price-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .price {
        font-size: 1.2rem;
        font-weight: 700;
      }

      .buy-btn {
        background: white;
        color: black;
        padding: 10px 18px;
        border-radius: 999px;
        font-weight: 600;
      }

      .about {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
      }

      .about img {
        width: 100%;
        border-radius: 28px;
        height: 650px;
        object-fit: cover;
      }

      .about-text p {
        color: var(--muted);
        line-height: 1.8;
        margin-top: 20px;
        font-size: 1.05rem;
      }

      .features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 24px;
      }

      .feature {
        border: 1px solid var(--line);
        background: var(--card);
        border-radius: 24px;
        padding: 30px;
      }

      .feature h3 {
        margin-bottom: 12px;
      }

      .feature p {
        color: var(--muted);
        line-height: 1.6;
      }

      footer {
        padding: 80px 0;
        border-top: 1px solid var(--line);
      }

      .footer-content {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 30px;
      }

      .footer-content p {
        color: var(--muted);
      }

      @media (max-width: 900px) {
        .hero,
        .about {
          grid-template-columns: 1fr;
        }

        .hero-text h1 {
          font-size: 3.5rem;
        }

        .hero-image img {
          height: 500px;
        }

        .about img {
          height: 500px;
        }

        .nav-links {
          display: none;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="container">
        <nav>
          <div class="logo">AMICBRIDGE</div>

          <div class="nav-links">
            <a href="#shop">Shop</a>
            <a href="#about">About</a>
            <a href="#features">Features</a>
          </div>
        </nav>
      </div>
    </header>

    <main class="container">
      <section class="hero">
        <div class="hero-text">
          <h1>
            Luxury
            <br />
            Underwear
            <br />
            Redefined
          </h1>

          <p>
            AmicBridge combines modern luxury, minimal aesthetics,
            and premium comfort into a next-generation fashion brand.
          </p>

          <div class="hero-buttons">
            <a href="#shop" class="btn btn-primary">
              Shop Collection
            </a>

            <a href="#about" class="btn btn-secondary">
              Learn More
            </a>
          </div>
        </div>

        <div class="hero-image">
          <img
            src="https://images.unsplash.com/photo-1496747611176-843222e1e57c?q=80&w=1400&auto=format&fit=crop"
            alt="Luxury Fashion"
          />
        </div>
      </section>

      <section class="section" id="shop">
        <h2 class="section-title">Featured Collection</h2>

        <div class="products">
          {
            products.map((product) => (
              <div class="product-card">
                <img src={product.image} alt={product.name} />

                <div class="product-info">
                  <h3>{product.name}</h3>

                  <p>{product.description}</p>

                  <div class="price-row">
                    <span class="price">{product.price}</span>

                    <a href="#" class="buy-btn">
                      Buy Now
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="section about" id="about">
        <img
          src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?q=80&w=1200&auto=format&fit=crop"
          alt="About AmicBridge"
        />

        <div class="about-text">
          <h2 class="section-title">
            Designed For The Future
          </h2>

          <p>
            AmicBridge is more than a fashion brand.
            It is a modern luxury experience built for the new internet.
          </p>

          <p>
            We combine minimalist aesthetics, premium materials,
            and digital-first commerce to create timeless collections.
          </p>

          <p>
            Built with elegance, speed, and modern payment systems
            including crypto integration.
          </p>
        </div>
      </section>

      <section class="section" id="features">
        <h2 class="section-title">Why AmicBridge</h2>

        <div class="features">
          <div class="feature">
            <h3>Premium Materials</h3>

            <p>
              High-quality fabrics with luxury comfort and feel.
            </p>
          </div>

          <div class="feature">
            <h3>Modern Design</h3>

            <p>
              Clean minimal branding inspired by luxury fashion houses.
            </p>
          </div>

          <div class="feature">
            <h3>Crypto Payments</h3>

            <p>
              Seamless checkout with USDC and modern payment systems.
            </p>
          </div>

          <div class="feature">
            <h3>Fast Experience</h3>

            <p>
              Optimized for mobile devices and lightning-fast loading.
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-content">
        <div>
          <div class="logo">AMICBRIDGE</div>
        </div>

        <p>
          © 2026 AmicBridge. All rights reserved.
        </p>
      </div>
    </footer>
  </body>
</html>
