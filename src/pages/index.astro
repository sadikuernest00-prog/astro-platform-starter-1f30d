---
import Dashboard from "../components/Dashboard.jsx";
---

<html lang="en">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>
      AmicBridge AI Escrow
    </title>

    <style>

      * {

        margin: 0;

        padding: 0;

        box-sizing: border-box;
      }

      body {

        background: #000;

        color: white;

        font-family:
          Arial,
          Helvetica,
          sans-serif;

        overflow-x: hidden;
      }

      .background {

        position: fixed;

        inset: 0;

        background:
          radial-gradient(
            circle at top,
            rgba(250,204,21,0.12),
            transparent 40%
          );

        z-index: -1;
      }

      .hero {

        min-height: 100vh;

        display: flex;

        flex-direction: column;

        align-items: center;

        justify-content: center;

        padding: 80px 24px;
      }

      .badge {

        background:
          rgba(255,255,255,0.05);

        border:
          1px solid rgba(255,255,255,0.08);

        padding: 12px 22px;

        border-radius: 999px;

        color: #facc15;

        font-size: 14px;

        letter-spacing: 1px;

        margin-bottom: 40px;
      }

      h1 {

        font-size: 80px;

        line-height: 1.05;

        text-align: center;

        max-width: 1200px;

        font-weight: 900;
      }

      .gold {

        color: #facc15;
      }

      .subtitle {

        margin-top: 40px;

        color: #a1a1aa;

        text-align: center;

        font-size: 24px;

        line-height: 1.8;

        max-width: 950px;
      }

      .features {

        margin-top: 100px;

        display: grid;

        grid-template-columns:
          repeat(auto-fit, minmax(280px, 1fr));

        gap: 24px;

        width: 100%;

        max-width: 1400px;
      }

      .card {

        background:
          linear-gradient(
            180deg,
            rgba(255,255,255,0.05),
            rgba(255,255,255,0.02)
          );

        border:
          1px solid rgba(255,255,255,0.08);

        padding: 35px;

        border-radius: 30px;

        transition: 0.3s ease;
      }

      .card:hover {

        transform:
          translateY(-8px);

        border-color:
          rgba(250,204,21,0.4);
      }

      .card h2 {

        font-size: 28px;

        margin-bottom: 20px;
      }

      .card p {

        color: #a1a1aa;

        line-height: 1.7;

        font-size: 18px;
      }

      .security {

        margin-top: 120px;

        width: 100%;

        max-width: 1400px;

        padding: 60px;

        border-radius: 40px;

        background:
          linear-gradient(
            180deg,
            rgba(250,204,21,0.08),
            rgba(255,255,255,0.02)
          );

        border:
          1px solid rgba(255,255,255,0.08);
      }

      .security h2 {

        font-size: 54px;

        margin-bottom: 30px;
      }

      .security-grid {

        display: grid;

        grid-template-columns:
          repeat(auto-fit, minmax(300px, 1fr));

        gap: 24px;

        margin-top: 50px;
      }

      .security-box {

        background:
          rgba(255,255,255,0.03);

        border:
          1px solid rgba(255,255,255,0.08);

        border-radius: 24px;

        padding: 30px;
      }

      .security-box h3 {

        font-size: 24px;

        color: #facc15;

        margin-bottom: 16px;
      }

      .security-box p {

        color: #a1a1aa;

        line-height: 1.7;
      }

      .dashboard {

        width: 100%;

        max-width: 1400px;

        margin-top: 120px;
      }

      footer {

        margin-top: 120px;

        color: #71717a;

        text-align: center;

        padding-bottom: 60px;

        font-size: 15px;
      }

    </style>

  </head>

  <body>

    <div class="background"></div>

    <section class="hero">

      <div class="badge">

        AI POWERED BLOCKCHAIN ESCROW

      </div>

      <h1>

        Secure Escrow Infrastructure

        <span class="gold">

          For International Trade

        </span>

      </h1>

      <p class="subtitle">

        AmicBridge combines AI fraud detection,
        USDC smart contracts and decentralized
        blockchain settlement to secure
        international trade and crypto payments.

      </p>

      <div class="features">

        <div class="card">

          <h2>
            Smart Contract Escrow
          </h2>

          <p>

            Funds are secured directly
            onchain using immutable
            escrow contracts deployed
            on Base blockchain.

          </p>

        </div>

        <div class="card">

          <h2>
            AI Fraud Detection
          </h2>

          <p>

            Artificial intelligence analyzes
            suspicious activity, wallet
            behavior, escrow velocity and
            transaction anomalies.

          </p>

        </div>

        <div class="card">

          <h2>
            USDC Settlement
          </h2>

          <p>

            Stablecoin settlement enables
            fast global payments with
            blockchain transparency and
            reduced banking friction.

          </p>

        </div>

      </div>

      <section class="security">

        <h2>

          AI Security Infrastructure

        </h2>

        <div class="security-grid">

          <div class="security-box">

            <h3>
              Wallet Intelligence
            </h3>

            <p>

              Detect suspicious wallets,
              scam behavior and blacklist
              matches before settlement.

            </p>

          </div>

          <div class="security-box">

            <h3>
              Risk Scoring
            </h3>

            <p>

              Every escrow receives
              real-time AI transaction
              risk analysis.

            </p>

          </div>

          <div class="security-box">

            <h3>
              Escrow Monitoring
            </h3>

            <p>

              Analyze escrow creation
              frequency, suspicious
              velocity and abnormal
              transaction behavior.

            </p>

          </div>

          <div class="security-box">

            <h3>
              Enterprise Compliance
            </h3>

            <p>

              Future-ready architecture
              for AML, sanctions screening
              and compliance systems.

            </p>

          </div>

        </div>

      </section>

      <div class="dashboard">

        <Dashboard client:load />

      </div>

      <footer>

        © 2026 AmicBridge —
        AI Escrow Infrastructure

      </footer>

    </section>

  </body>

</html>
