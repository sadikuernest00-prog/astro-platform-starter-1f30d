---
import Dashboard from "../components/Dashboard.jsx";
---

<html lang="en">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>
      AmicBridge AI Escrow Security
    </title>

    <style>

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {

        background: black;

        color: white;

        font-family:
          Arial,
          Helvetica,
          sans-serif;

        overflow-x: hidden;
      }

      .background {

        position: fixed;

        inset: 0;

        background:
          radial-gradient(
            circle at top,
            rgba(255, 215, 0, 0.12),
            transparent 40%
          );

        z-index: -1;
      }

      .hero {

        min-height: 100vh;

        display: flex;

        flex-direction: column;

        align-items: center;

        justify-content: center;

        padding: 80px 24px;
      }

      .badge {

        border: 1px solid rgba(255,255,255,0.1);

        background: rgba(255,255,255,0.04);

        padding: 10px 20px;

        border-radius: 999px;

        margin-bottom: 30px;

        color: #facc15;

        font-size: 14px;

        letter-spacing: 1px;
      }

      h1 {

        font-size: 72px;

        text-align: center;

        max-width: 1100px;

        line-height: 1.05;

        font-weight: 900;
      }

      .gold {
        color: #facc15;
      }

      .subtitle {

        margin-top: 40px;

        max-width: 900px;

        text-align: center;

        color: #a1a1aa;

        font-size: 24px;

        line-height: 1.8;
      }

      .cards {

        margin-top: 90px;

        display: grid;

        grid-template-columns:
          repeat(auto-fit, minmax(280px, 1fr));

        gap: 24px;

        width: 100%;

        max-width: 1400px;
      }

      .card {

        background:
          linear-gradient(
            180deg,
            rgba(255,255,255,0.05),
            rgba(255,255,255,0.02)
          );

        border:
          1px solid rgba(255,255,255,0.08);

        padding: 35px;

        border-radius: 30px;

        backdrop-filter: blur(10px);

        transition: 0.3s ease;
      }

      .card:hover {

        transform:
          translateY(-8px);

        border-color:
          rgba(250,204,21,0.5);
      }

      .card h2 {

        font-size: 26px;

        margin-bottom: 18px;
      }

      .card p {

        color: #a1a1aa;

        line-height: 1.7;

        font-size: 18px;
      }

      .security {

        margin-top: 120px;

        width: 100%;

        max-width: 1400px;

        padding: 60px;

        border-radius: 40px;

        background:
          linear-gradient(
            180deg,
            rgba(250,204,21,0.08),
            rgba(255,255,255,0.02)
          );

        border:
          1px solid rgba(255,255,255,0.08);
      }

      .security h2 {

        font-size: 52px;

        margin-bottom: 30px;
      }

      .security-grid {

        display: grid;

        grid-template-columns:
          repeat(auto-fit, minmax(300px, 1fr));

        gap: 24px;

        margin-top: 50px;
      }

      .security-box {

        background:
          rgba(255,255,255,0.03);

        border:
          1px solid rgba(255,255,255,0.08);

        border-radius: 24px;

        padding: 30px;
      }

      .security-box h3 {

        font-size: 24px;

        margin-bottom: 16px;

        color: #facc15;
      }

      .security-box p {

        color: #a1a1aa;

        line-height: 1.7;
      }

      .dashboard-wrapper {

        margin-top: 120px;

        width: 100%;

        max-width: 1400px;
      }

      footer {

        margin-top: 120px;

        text-align: center;

        color: #71717a;

        padding-bottom: 60px;

        font-size: 15px;
      }

    </style>

  </head>

  <body>

    <div class="background"></div>

    <section class="hero">

      <div class="badge">

        AI POWERED BLOCKCHAIN ESCROW

      </div>

      <h1>

        Enterprise Escrow Infrastructure

        <span class="gold">
          Powered By AI Fraud Detection
        </span>

      </h1>

      <p class="subtitle">

        AmicBridge combines blockchain escrow,
        USDC smart contracts, decentralized
        settlement and real-time AI fraud
        analysis to secure international trade,
        crypto payments and high-value
        transactions.

      </p>

      <div class="cards">

        <div class="card">

          <h2>
            Smart Contract Escrow
          </h2>

          <p>

            Funds are secured directly
            onchain through immutable
            escrow contracts deployed
            on Base blockchain.

          </p>

        </div>

        <div class="card">

          <h2>
            AI Fraud Detection
          </h2>

          <p>

            Machine intelligence analyzes
            transaction behavior, wallet
            reputation, escrow velocity,
            amount anomalies and suspicious
            patterns before settlement.

          </p>

        </div>

        <div class="card">

          <h2>
            Stablecoin Settlement
          </h2>

          <p>

            USDC powered payments allow
            instant global settlement with
            blockchain transparency and
            reduced banking friction.

          </p>

        </div>

      </div>

      <section class="security">

        <h2>

          AI Security Infrastructure

        </h2>

        <div class="security-grid">

          <div class="security-box">

            <h3>
              Wallet Intelligence
            </h3>

            <p>

              Detects suspicious wallet
              activity, blacklist matches,
              unusual behavior and risky
              transaction patterns.

            </p>

          </div>

          <div class="security-box">

            <h3>
              Transaction Risk Scoring
            </h3>

            <p>

              Every escrow transaction
              receives dynamic AI risk
              analysis before approval.

            </p>

          </div>

          <div class="security-box">

            <h3>
              Anti Scam Protection
            </h3>

            <p>

              AI systems identify scam
              behavior, escrow farming,
              rapid abuse attempts and
              abnormal fund movement.

            </p>

          </div>

          <div class="security-box">

            <h3>
              Enterprise Compliance
            </h3>

            <p>

              Future integrations include
              sanctions screening,
              AML compliance and advanced
              blockchain analytics.

            </p>

          </div>

        </div>

      </section>

      <div class="dashboard-wrapper">

        <Dashboard client:load />

      </div>

      <footer>

        © 2026 AmicBridge —
        AI Escrow Infrastructure

      </footer>

    </section>

  </body>

</html>
